# Environment Variables
PROJECT_NAME="SMART-EDU LMS Backend"
API_V1_STR="/api/v1"

# Database Configuration (Mặc định dùng SQLite có sẵn)
# Chuyển sang PostgreSQL nếu chạy qua Docker:
# DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword2026@localhost:5432/language_center
DATABASE_URL=sqlite:///../database/language_center.db

# JWT Security
# Tạo chuỗi bí mật an toàn trong production
JWT_SECRET=super_secret_jwt_key_smart_edu_ver2_secure_token_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (Cho phép Frontend Vite)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
